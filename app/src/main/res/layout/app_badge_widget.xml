<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:padding="0dp">
    <LinearLayout android:id="@+id/badge_rows" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginEnd="28dp" android:orientation="vertical" />
    <TextView android:id="@+id/badge_status" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:layout_marginEnd="28dp" android:textColor="#FFFFFF" android:shadowColor="#000000" android:shadowRadius="2" android:textSize="12sp" />
    <TextView android:id="@+id/badge_settings" android:layout_width="28dp" android:layout_height="48dp" android:layout_gravity="top|end"
        android:text="⋮" android:contentDescription="Configure app badges" android:textColor="#FFFFFF" android:shadowColor="#000000" android:shadowRadius="2" android:textSize="22sp" android:gravity="center" />
</FrameLayout>
